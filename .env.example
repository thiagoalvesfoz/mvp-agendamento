# =========================================================
# Variáveis de ambiente — copie para .env.local e preencha
# =========================================================

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Database (Postgres) ---
# Para dev local, usar Docker Compose: pnpm db:up
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agenda?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/agenda?schema=public"

# --- Auth.js (NextAuth v5) ---
# Gere com: openssl rand -base64 32
AUTH_SECRET="iNqg/B/pB0Ityeb9Ev/9IJ8+9bT1PERcnS7aVrh+efI="
AUTH_TRUST_HOST="true"

# --- Email (Resend) ---
# Opcional na fase de descoberta — deixe RESEND_API_KEY vazio para
# desativar envio (vira no-op + console.log).
#
# Habilitando:
#   1. Crie conta em resend.com (3.000 emails/mês grátis).
#   2. Em dev, EMAIL_FROM="onboarding@resend.dev" funciona sem DNS,
#      mas o destinatário precisa ser o email do dono da conta Resend.
#      Use EMAIL_DEV_MODE=true + EMAIL_DEV_TO=seu@email pra redirecionar
#      todos os envios pra você sem spammar clientes reais.
#   3. Em prod, verifique seu domínio no painel Resend e troque
#      EMAIL_FROM para "contato@seudominio.com" (ou similar).
RESEND_API_KEY=""
EMAIL_FROM="onboarding@resend.dev"

# Quando "true", redireciona TODO email para o notificationEmail configurado no painel.
# Use em dev para não spammar clientes reais.
EMAIL_DEV_MODE="false"

# Sentry — source maps upload (obter em sentry.io/settings/auth-tokens)
SENTRY_AUTH_TOKEN=

# --- Captcha (Cloudflare Turnstile) ---
# Opcional na descoberta — deixe vazio para pular validação
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# --- Rate limit (Upstash Redis) ---
# Opcional na descoberta — deixe vazio para desativar
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Cron ---
# Segredo para autenticar chamadas do Vercel Cron
CRON_SECRET=""
